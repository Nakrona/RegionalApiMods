{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.regionalapi.fabric.RegionalFabricMod"
    ],
    "client": [
      "com.regionalapi.fabric.RegionalFabricClientMod"
    ]
  },
  "mixins": [
    "regionalapi.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
